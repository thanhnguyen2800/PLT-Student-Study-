# Gemini API
GEMINI_API_KEY=

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIRESTORE_DATABASE_ID=
