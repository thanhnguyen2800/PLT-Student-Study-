{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user account with RBAC",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "TEACHER", "PLAYER"] },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "PENDING"] },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Study quiz with questions and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "timeLimit": { "type": "number" },
        "visibility": { "type": "string", "enum": ["PUBLIC", "PRIVATE", "SHARED"] },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "coverImage": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "ownerId", "visibility"]
    },
    "Question": {
      "title": "Question",
      "description": "Question within a quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quizId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "points": { "type": "number" },
        "timeLimit": { "type": "number" }
      },
      "required": ["id", "quizId", "content", "options", "correctAnswer"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a quiz attempt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quizId": { "type": "string" },
        "userId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "quizId", "userId", "score"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit security log of administrative changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Realtime multiplayer game room and live state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pin": { "type": "string" },
        "quizId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "status": { "type": "string", "enum": ["WAITING", "QUESTION_ACTIVE", "LEADERBOARD", "FINISHED"] },
        "currentQuestionIndex": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "players": { "type": "array" },
        "answers": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pin", "quizId", "hostId", "status"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "User support inquiries, questions, and feedback tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 50 },
        "email": { "type": "string", "format": "email", "maxLength": 100 },
        "subject": { "type": "string", "minLength": 5, "maxLength": 100 },
        "message": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "RESOLVED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userRole": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "subject", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and RBAC access roles"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Study quizzes stored and managed"
    },
    "/quizzes/{quizId}/questions/{questionId}": {
      "schema": "Question",
      "description": "Questions belonging to a quiz"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "User completion scores and logs"
    },
    "/gameSessions/{sessionId}": {
      "schema": "GameSession",
      "description": "Live realtime multiplayer game rooms and player scores"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin security and permission logs"
    },
    "/supportMessages/{messageId}": {
      "schema": "SupportMessage",
      "description": "User feedback and technical support tickets stored in Firebase Firestore"
    }
  }
}
