{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user account with RBAC",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "TEACHER", "PLAYER"] },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "PENDING"] },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Study quiz with questions and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "timeLimit": { "type": "number" },
        "visibility": { "type": "string", "enum": ["PUBLIC", "PRIVATE", "SHARED"] },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "coverImage": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "ownerId", "visibility"]
    },
    "Question": {
      "title": "Question",
      "description": "Question within a quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quizId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "points": { "type": "number" },
        "timeLimit": { "type": "number" }
      },
      "required": ["id", "quizId", "content", "options", "correctAnswer"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a quiz attempt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quizId": { "type": "string" },
        "userId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "quizId", "userId", "score"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit security log of administrative changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "target": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and RBAC access roles"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Study quizzes stored and managed"
    },
    "/quizzes/{quizId}/questions/{questionId}": {
      "schema": "Question",
      "description": "Questions belonging to a quiz"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "User completion scores and logs"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin security and permission logs"
    }
  }
}
